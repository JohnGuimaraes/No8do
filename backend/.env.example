# Variáveis de ambiente reconhecidas pelo backend (application.yml).
# Os valores abaixo já são os padrões usados em desenvolvimento local
# caso as variáveis não sejam definidas - este arquivo é só documentação.

DB_URL=jdbc:postgresql://localhost:5432/no8do
DB_USER=no8do
DB_PASSWORD=no8do_dev
SERVER_PORT=8080

# Cofre do projeto: Base64 de exatamente 32 bytes. Sem valor padrao seguro.
NO8DO_CREDENTIALS_MASTER_KEY=
