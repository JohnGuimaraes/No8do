# Desenvolvimento local (padrões de application.yml).

DB_URL=jdbc:postgresql://localhost:5432/no8do
DB_USER=no8do
DB_PASSWORD=no8do_dev
SERVER_PORT=8080

# Cofre do projeto: Base64 de exatamente 32 bytes. Sem valor padrao seguro.
NO8DO_CREDENTIALS_MASTER_KEY=
NO8DO_REGISTRATION_ENABLED=
NO8DO_GOOGLE_CLIENT_ID=
NO8DO_GOOGLE_CLIENT_SECRET=

# SMTP para recuperação de senha. Não inclua credenciais reais neste arquivo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true

# Produção/Coolify: use SPRING_PROFILES_ACTIVE=prod e informe todos os valores abaixo.
# Não use valores de desenvolvimento ou segredos reais neste arquivo.
SPRING_PROFILES_ACTIVE=prod
NO8DO_FRONTEND_URL=
NO8DO_CORS_ALLOWED_ORIGIN=
NO8DO_GITHUB_REDIRECT_URI=
NO8DO_GITHUB_APP_CALLBACK_URL=
NO8DO_GITHUB_CLIENT_ID=
NO8DO_GITHUB_CLIENT_SECRET=
NO8DO_GITHUB_APP_ID=
NO8DO_GITHUB_APP_SLUG=
NO8DO_GITHUB_APP_CLIENT_ID=
NO8DO_GITHUB_APP_CLIENT_SECRET=
NO8DO_GITHUB_APP_PRIVATE_KEY=
